@model Customer;
@{
    ViewData["Title"] = "My Profile";
}

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        @TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<div class="row justify-content-center">
    <div class="col-md-6">
        <div class="card">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-start mb-4">
                    <h3 class="card-title mb-0">Personal Information</h3>
                    <a asp-action="EditProfile" class="btn btn text-dark" style="background-color: #f0d000; border: 1px solid #ddd;">Edit Profile</a>
                </div>

                <dl class="row">
                    <dt class="col-sm-4">@Html.DisplayNameFor(x => x.Name):</dt>
                    <dd class="col-sm-8">@(Model.Name ?? "-")</dd>

                    <dt class="col-sm-4">@Html.DisplayNameFor(x => x.TFN):</dt>
                    <dd class="col-sm-8">@(Model.TFN ?? "-")</dd>

                    <dt class="col-sm-4">@Html.DisplayNameFor(x => x.Address):</dt>
                    <dd class="col-sm-8">@(Model.Address ?? "-")</dd>

                    <dt class="col-sm-4">@Html.DisplayNameFor(x => x.City):</dt>
                    <dd class="col-sm-8">@(Model.City ?? "-")</dd>

                    <dt class="col-sm-4">@Html.DisplayNameFor(x => x.State):</dt>
                    <dd class="col-sm-8">@(Model.State?.ToString() ?? "-")</dd>

                    <dt class="col-sm-4">@Html.DisplayNameFor(x => x.Postcode):</dt>
                    <dd class="col-sm-8">@(Model.Postcode ?? "-")</dd>

                    <dt class="col-sm-4">@Html.DisplayNameFor(x => x.Mobile):</dt>
                    <dd class="col-sm-8">@(Model.Mobile ?? "-")</dd>
                </dl>
                <a asp-action="EditPassword" class="btn btn-primary">Change Password</a>
            </div>
        </div>
    </div>
</div>