@model BankingApplication.ViewModels.TransactionConfirmationViewModel;

@{
    ViewData["Title"] = "Confirm Transaction";
}

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card">
                <div class="card-body">
                    <h3 class="card-title mb-4">Confirm Your Transaction</h3>
                    
                    <div class="mb-4">
                        <h5 class="mb-3">Transaction Details</h5>
                        <div class="row mb-3">
                            <div class="col-sm-4"><strong>Transaction Type:</strong></div>
                            <div class="col-sm-8">
                                <span>@Model.DisplayTransactionType</span>
                            </div>
                        </div>
                        <div class="row mb-3">
                            <div class="col-sm-4"><strong>@Model.DisplayAccountLabel</strong></div>
                            <div class="col-sm-8">@Model.Account.AccountNumber - @Model.DisplayAccountType</div>
                        </div>
                        @if (Model.TransactionType == TransactionType.T)
                        {
                            <div class="row mb-3">
                                <div class="col-sm-4"><strong>To Account:</strong></div>
                                <div class="col-sm-8">@Model.DestinationAccountNumber</div>
                            </div>
                        }
                        <div class="row mb-3">
                            <div class="col-sm-4"><strong>Current Balance:</strong></div>
                            <div class="col-sm-8">@Model.Account.Balance.ToString("C")</div>
                        </div>
                        <div class="row mb-3">
                            <div class="col-sm-4"><strong>Amount:</strong></div>
                            <div class="col-sm-8">@Model.Amount.ToString("C")</div>
                        </div>
                        @if (Model.TransactionType == TransactionType.W || Model.TransactionType == TransactionType.T)
                        {
                            <div class="row mb-3">
                                <div class="col-sm-4"><strong>Service Charge:</strong></div>
                                <div class="col-sm-8">@Model.ServiceCharge.ToString("C")</div>
                            </div>
                        }
                        <div class="row mb-3">
                            <div class="col-sm-4"><strong>Comment:</strong></div>
                            @if (!string.IsNullOrEmpty(Model.Comment))
                            {
                                <div class="col-sm-8">@Model.Comment</div>
                            }
                            else
                            {
                                <div class="col-sm-8"></div>
                            }
                        </div>
                        <hr>
                        <div class="row mb-3">
                            <div class="col-sm-4"><strong>New Balance:</strong></div>
                            <div class="col-sm-8">@Model.NewBalance.ToString("C")</div>
                        </div>
                    </div>

                    <form id="confirmForm" asp-action="ConfirmTransaction" method="post">
                        <input type="hidden" name="transactionType" value="@Model.TransactionType" />
                        <input type="hidden" name="accountNumber" value="@Model.Account.AccountNumber" />
                        <input type="hidden" name="amount" value="@Model.Amount" />
                        <input type="hidden" name="comment" value="@Model.Comment" />
                        @if (Model.TransactionType == TransactionType.T)
                        {
                            <input type="hidden" name="destinationAccountNumber" value="@Model.DestinationAccountNumber" />
                        }
                    </form>
                    
                    <div class="d-grid gap-2">
                        <button type="submit" form="confirmForm" class="btn text-dark" style="background-color: #f0d000; border: 2px solid #d39e00;">Confirm Transaction</button>
                        <a asp-action="Deposit" class="btn btn-secondary">Cancel and Go Back</a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>