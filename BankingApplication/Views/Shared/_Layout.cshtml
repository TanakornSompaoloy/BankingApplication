<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - MacbaBank</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/McbaApplication.styles.css" asp-append-version="true" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-light bg-white border-bottom box-shadow mb-3">
            <div class="container">
                <a class="navbar-brand text-dark px-3 py-1 rounded" asp-controller="Home" asp-action="Index" style="background-color: #f0d000;">MCBA Bank</a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    @{
                        var isLoggedIn = Context.Session.GetInt32(nameof(Customer.CustomerID)).HasValue;
                    }
                    <ul class="navbar-nav">
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-controller="Home" asp-action="Privacy">Privacy</a>
                        </li>
                        @if (isLoggedIn)
                        {
                            <li class="nav-item">
                                <span class="nav-link text-muted">|</span>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link text-dark" asp-controller="Customer" asp-action="Index">My Accounts</a>
                            </li>
                            <li class="nav-item">
                                <span class="nav-link text-muted">|</span>
                            </li>
                        }
                    </ul>
                    @if (isLoggedIn)
                    {
                        <ul class="navbar-nav flex-grow-1">
                            <li class="nav-item">
                                <a class="nav-link text-dark" asp-controller="Customer" asp-action="Deposit">Deposit</a>
                            </li>
                            <li class="nav-item">
                                <span class="nav-link text-muted">|</span>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link text-dark" asp-controller="Customer" asp-action="Withdraw">Withdraw</a>
                            </li>
                            <li class="nav-item">
                                <span class="nav-link text-muted">|</span>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link text-dark" asp-controller="Customer" asp-action="Transfer">Transfer</a>
                            </li>
                            <li class="nav-item">
                                <span class="nav-link text-muted">|</span>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link text-dark" asp-controller="Customer" asp-action="Statements">My Statements</a>
                            </li>
                            <li class="nav-item">
                                <span class="nav-link text-muted">|</span>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link text-dark" asp-controller="Customer" asp-action="BillPay">Bill Pay</a>
                            </li>
                            <li class="nav-item">
                                <span class="nav-link text-muted">|</span>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link text-dark" asp-controller="Customer" asp-action="Profile">My Profile</a>
                            </li>
                        </ul>
                    }

                    <ul class="navbar-nav">
                        
                        @if (isLoggedIn)
                        {
                            <li class="nav-item">
                                <a class="btn text-dark" asp-controller="Login" asp-action="Logout" style="background-color: #f0d000; border: 1px solid #ddd;">Logout</a>
                            </li>
                        }
                        else
                        {
                            <li class="nav-item">
                                <a class="btn text-dark" asp-controller="Login" asp-action="Index" style="background-color: #f0d000; border: 1px solid #ddd;">Login</a>
                            </li>
                        }
                    </ul>
                </div>
            </div>
        </nav>
    </header>
    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted">
        <div class="container">
            &copy; 2025 - McbaBank - <a asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
