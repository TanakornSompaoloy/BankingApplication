@{
    ViewData["Title"] = "Home Page";
}

<div class="text-center mb-5">
    <h1 class="display-4">Welcome to MCBA Bank</h1>
</div>

<div class="row">
    <div class="row justify-content-center">
        <div class="col-md-10">
            <p class="lead text-center p-4 border rounded" style="background-color: #fefbf0; border-color: #f0d000 !important; font-size: 1.1rem; line-height: 1.8;">
                As Australia's oldest financial institution, established since the nation's founding, we deliver the most secure banking. Our commitment is to offer unlimited financial opportunities.
            </p>
        </div>
    </div>
    <div class="col-md-6 mb-3">
        <div class="card">
            <div class="card-body text-center">
                <h5 class="card-title" style="background-color: #f0d000; border: 1px solid #ddd;">Transfer Money</h5>
                <p class="card-text" style="height: 48px;">Transfer funds between your accounts or to other customers.</p>
            </div>
        </div>
    </div>
    <div class="col-md-6 mb-3">
        <div class="card">
            <div class="card-body text-center">
                <h5 class="card-title" style="background-color: #f0d000; border: 1px solid #ddd;">Deposit</h5>
                <p class="card-text" style="height: 48px;">Make deposits to your savings or checking accounts.</p>
            </div>
        </div>
    </div>
</div>
<div class="row">
    <div class="col-md-6 mb-3">
        <div class="card">
            <div class="card-body text-center">
                <h5 class="card-title" style="background-color: #f0d000; border: 1px solid #ddd;">Withdraw</h5>
                <p class="card-text" style="height: 48px;">Withdraw funds from your accounts.</p>
            </div>
        </div>
    </div>
    <div class="col-md-6 mb-3">
        <div class="card">
            <div class="card-body text-center">
                <h5 class="card-title" style="background-color: #f0d000; border: 1px solid #ddd;">Bill Pay</h5>
                <p class="card-text" style="height: 48px;">Pay your bills and manage recurring payments.</p>
            </div>
        </div>
    </div>
</div>
